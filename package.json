{
  "name": "@ramiidv/arca-common",
  "version": "0.3.0",
  "description": "Utilidades compartidas para los SDKs de ARCA (ex AFIP) - WSAA, SOAP client, validadores, tipos comunes",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run test:smoke",
    "test:smoke": "node scripts/smoke.mjs WsaaClient ArcaError ArcaTicketVigenteError MemoryTicketStorage FileTicketStorage CondicionIva"
  },
  "keywords": [
    "arca",
    "afip",
    "argentina",
    "sdk",
    "typescript",
    "wsaa",
    "soap",
    "common"
  ],
  "author": "ramiidv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiidv/arca-common.git"
  },
  "homepage": "https://arca-sdk.dev/common",
  "bugs": {
    "url": "https://github.com/ramiidv/arca-common/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0",
    "node-forge": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "module": "./dist/esm/index.js"
}
